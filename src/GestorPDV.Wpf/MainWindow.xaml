<Window x:Class="GestorPDV.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestorPDV" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="GestorPDV" FontSize="28" FontWeight="Bold" Foreground="#1F2937" />
            <TextBlock Text="ERP/PDV — varejo, oficina, supermercado, farmácia, indústria e segmentos similares"
                       FontSize="13" Foreground="#6B7280" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,0" Padding="16" CornerRadius="6"
                Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#DC2626" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOk}" Value="True">
                                    <Setter Property="Fill" Value="#16A34A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMensagem}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,24,0,0" VerticalAlignment="Bottom"
                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"
                   Text="Fase 3 concluída: estrutura do projeto e inicialização do banco de dados. Login, cadastros, vendas, pagamentos, relatórios e impressão chegam nas próximas fases." />
    </Grid>
</Window>
