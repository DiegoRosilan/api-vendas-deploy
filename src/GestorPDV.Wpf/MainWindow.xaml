<Window x:Class="GestorPDV.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GestorPDV.Wpf.ViewModels"
        xmlns:views="clr-namespace:GestorPDV.Wpf.Views"
        Title="GestorPDV" Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DbStatusViewModel}">
            <views:DbStatusView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrocarSenhaViewModel}">
            <views:TrocarSenhaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
