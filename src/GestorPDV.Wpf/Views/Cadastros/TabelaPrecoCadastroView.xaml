<UserControl x:Class="GestorPDV.Wpf.Views.Cadastros.TabelaPrecoCadastroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tabelas de preço" FontSize="22" FontWeight="Bold" Foreground="#1F2937" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Padding="10,4" Margin="0,0,8,0" />
                <Button Content="Voltar" Command="{Binding VoltarCommand}" Padding="12,6" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                    <DataGridTextColumn Header="Vigência início" Binding="{Binding VigenciaInicio, StringFormat=d}" Width="110" />
                    <DataGridTextColumn Header="Vigência fim" Binding="{Binding VigenciaFim, StringFormat=d}" Width="110" />
                    <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding Ativo}" Width="55" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Padding="16" CornerRadius="6" Background="White"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel DataContext="{Binding EntidadeEmEdicao}">
                    <TextBlock Text="Descrição" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Filial" Style="{StaticResource RotuloCampo}" />
                    <ComboBox SelectedValue="{Binding FilialId}" SelectedValuePath="Id" DisplayMemberPath="RazaoSocial"
                              ItemsSource="{Binding DataContext.Filiais, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vigência início" Style="{StaticResource RotuloCampo}" />
                            <DatePicker SelectedDate="{Binding VigenciaInicio, Converter={StaticResource DateOnlyParaDateTime}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vigência fim" Style="{StaticResource RotuloCampo}" />
                            <DatePicker SelectedDate="{Binding VigenciaFim, Converter={StaticResource DateOnlyParaDateTime}}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Ativa" IsChecked="{Binding Ativo}" Margin="0,12,0,0" />

                    <Button Content="Nova" Command="{Binding DataContext.NovoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Margin="0,20,0,0" Padding="10,6" />
                    <Button Content="Salvar" Style="{StaticResource BotaoPrimario}"
                            Command="{Binding DataContext.SalvarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Margin="0,8,0,0" />

                    <TextBlock Text="{Binding DataContext.Mensagem, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               TextWrapping="Wrap" Foreground="#2563EB" Margin="0,10,0,0" />

                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#9CA3AF"
                               Text="A associação de produtos e preços a esta tabela chega na Fase 6, junto com a resolução de preço da venda." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
