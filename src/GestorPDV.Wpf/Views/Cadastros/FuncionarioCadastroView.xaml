<UserControl x:Class="GestorPDV.Wpf.Views.Cadastros.FuncionarioCadastroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Funcionários" FontSize="22" FontWeight="Bold" Foreground="#1F2937" />
            <Button Grid.Column="1" Content="Voltar" Command="{Binding VoltarCommand}" Padding="12,6" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Pesquisar" Command="{Binding PesquisarCommand}" Padding="10,4" Margin="8,0,0,0" />
                    <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Pessoa.Nome}" Width="*" />
                        <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="140" />
                        <DataGridCheckBoxColumn Header="Gerente" Binding="{Binding EhGerente}" Width="70" />
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Pessoa.Ativo}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="2" Padding="16" CornerRadius="6" Background="White"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding EntidadeEmEdicao}">
                        <TextBlock Text="Tipo de pessoa" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                        <ComboBox SelectedItem="{Binding Pessoa.TipoPessoa}"
                                  ItemsSource="{Binding DataContext.TiposPessoaDisponiveis, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                        <TextBlock Text="Nome" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Pessoa.Nome, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="CPF" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Pessoa.CpfCnpj, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Telefone" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Pessoa.Telefone, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Filial" Style="{StaticResource RotuloCampo}" />
                        <ComboBox SelectedValue="{Binding FilialId}" SelectedValuePath="Id" DisplayMemberPath="RazaoSocial"
                                  ItemsSource="{Binding DataContext.Filiais, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                        <TextBlock Text="Cargo" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Comissão padrão (%)" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding ComissaoPadraoPct, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Admissão" Style="{StaticResource RotuloCampo}" />
                                <DatePicker SelectedDate="{Binding DataAdmissao, Converter={StaticResource DateOnlyParaDateTime}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Demissão" Style="{StaticResource RotuloCampo}" />
                                <DatePicker SelectedDate="{Binding DataDemissao, Converter={StaticResource DateOnlyParaDateTime}}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="É gerente" IsChecked="{Binding EhGerente}" Margin="0,12,0,0" />
                        <CheckBox Content="Ativo" IsChecked="{Binding Pessoa.Ativo}" Margin="0,8,0,0" />

                        <Button Content="Novo" Command="{Binding DataContext.NovoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,20,0,0" Padding="10,6" />
                        <Button Content="Salvar" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding DataContext.SalvarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,8,0,0" />

                        <TextBlock Text="{Binding DataContext.Mensagem, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   TextWrapping="Wrap" Foreground="#2563EB" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
