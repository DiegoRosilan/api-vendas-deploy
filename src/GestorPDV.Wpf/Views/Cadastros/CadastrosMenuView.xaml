<UserControl x:Class="GestorPDV.Wpf.Views.Cadastros.CadastrosMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BotaoMenu" TargetType="Button">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Cadastros" FontSize="24" FontWeight="Bold" Foreground="#1F2937" />
            <Button Grid.Column="1" Content="Voltar" Command="{Binding VoltarCommand}" Padding="12,6" />
        </Grid>

        <WrapPanel Grid.Row="1">
            <Button Style="{StaticResource BotaoMenu}" Content="Produtos" Command="{Binding AbrirProdutosCommand}" />
            <Button Style="{StaticResource BotaoMenu}" Content="Serviços" Command="{Binding AbrirServicosCommand}" />
            <Button Style="{StaticResource BotaoMenu}" Content="Clientes" Command="{Binding AbrirClientesCommand}" />
            <Button Style="{StaticResource BotaoMenu}" Content="Fornecedores" Command="{Binding AbrirFornecedoresCommand}" />
            <Button Style="{StaticResource BotaoMenu}" Content="Funcionários" Command="{Binding AbrirFuncionariosCommand}" />
            <Button Style="{StaticResource BotaoMenu}" Content="Filiais" Command="{Binding AbrirFiliaisCommand}" />
            <Button Style="{StaticResource BotaoMenu}" Content="Formas de pagamento" Command="{Binding AbrirFormasPagamentoCommand}" />
            <Button Style="{StaticResource BotaoMenu}" Content="Condições de pagamento" Command="{Binding AbrirCondicoesPagamentoCommand}" />
            <Button Style="{StaticResource BotaoMenu}" Content="Tabelas de preço" Command="{Binding AbrirTabelasPrecoCommand}" />
        </WrapPanel>
    </Grid>
</UserControl>
