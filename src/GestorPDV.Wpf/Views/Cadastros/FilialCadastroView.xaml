<UserControl x:Class="GestorPDV.Wpf.Views.Cadastros.FilialCadastroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Filiais" FontSize="22" FontWeight="Bold" Foreground="#1F2937" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Padding="10,4" Margin="0,0,8,0" />
                <Button Content="Voltar" Command="{Binding VoltarCommand}" Padding="12,6" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="70" />
                    <DataGridTextColumn Header="Razão social" Binding="{Binding RazaoSocial}" Width="*" />
                    <DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="130" />
                    <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="45" />
                    <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding Ativo}" Width="55" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Padding="16" CornerRadius="6" Background="White"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding EntidadeEmEdicao}">
                        <TextBlock Text="Código" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Razão social" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding RazaoSocial, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Nome fantasia" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding NomeFantasia, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CNPJ" Style="{StaticResource RotuloCampo}" />
                                <TextBox Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Inscrição estadual" Style="{StaticResource RotuloCampo}" />
                                <TextBox Text="{Binding InscricaoEstadual, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Endereço" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Município" Style="{StaticResource RotuloCampo}" />
                                <TextBox Text="{Binding Municipio, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="UF" Style="{StaticResource RotuloCampo}" />
                                <TextBox Text="{Binding Uf, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Telefone" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Content="Ativa" IsChecked="{Binding Ativo}" Margin="0,12,0,0" />

                        <Button Content="Nova" Command="{Binding DataContext.NovoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,20,0,0" Padding="10,6" />
                        <Button Content="Salvar" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding DataContext.SalvarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,8,0,0" />

                        <TextBlock Text="{Binding DataContext.Mensagem, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   TextWrapping="Wrap" Foreground="#2563EB" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
