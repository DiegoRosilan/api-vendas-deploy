<UserControl x:Class="GestorPDV.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="28" CornerRadius="8" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="GestorPDV" FontSize="26" FontWeight="Bold" Foreground="#1F2937"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Acesse com seu usuário e senha" FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,4,0,20" />

                <TextBlock Text="Usuário" FontSize="12" Foreground="#374151" Margin="0,0,0,4" />
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" Margin="0,0,0,12" />

                <TextBlock Text="Senha" FontSize="12" Foreground="#374151" Margin="0,0,0,4" />
                <PasswordBox x:Name="CaixaSenha" Padding="8" Margin="0,0,0,4"
                             PasswordChanged="CaixaSenha_PasswordChanged" />

                <TextBlock Text="{Binding ErroMensagem}" Foreground="#DC2626" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ErroMensagem, Converter={StaticResource BoolParaVisibilidade}}" />

                <Button Content="Entrar" Command="{Binding EntrarCommand}"
                        Margin="0,20,0,0" Padding="10" FontWeight="Bold"
                        Background="#2563EB" Foreground="White" BorderThickness="0" />

                <TextBlock Text="Verificando..." FontSize="11" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="{Binding EstaCarregando, Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
