<UserControl x:Class="GestorPDV.Wpf.Views.TrocarSenhaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="28" CornerRadius="8" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Troca de senha obrigatória" FontSize="20" FontWeight="Bold"
                           Foreground="#1F2937" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding NomeUsuario}" FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,4,0,20" />

                <TextBlock Text="Senha atual" FontSize="12" Foreground="#374151" Margin="0,0,0,4" />
                <PasswordBox x:Name="CaixaSenhaAtual" Padding="8" Margin="0,0,0,12"
                             PasswordChanged="CaixaSenhaAtual_PasswordChanged" />

                <TextBlock Text="Nova senha" FontSize="12" Foreground="#374151" Margin="0,0,0,4" />
                <PasswordBox x:Name="CaixaNovaSenha" Padding="8" Margin="0,0,0,12"
                             PasswordChanged="CaixaNovaSenha_PasswordChanged" />

                <TextBlock Text="Confirmar nova senha" FontSize="12" Foreground="#374151" Margin="0,0,0,4" />
                <PasswordBox x:Name="CaixaConfirmarSenha" Padding="8" Margin="0,0,0,4"
                             PasswordChanged="CaixaConfirmarSenha_PasswordChanged" />

                <TextBlock Text="{Binding ErroMensagem}" Foreground="#DC2626" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ErroMensagem, Converter={StaticResource BoolParaVisibilidade}}" />

                <Button Content="Confirmar" Command="{Binding ConfirmarCommand}"
                        Margin="0,20,0,0" Padding="10" FontWeight="Bold"
                        Background="#2563EB" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
